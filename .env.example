# HuggingFace Token for downloading TSRD dataset (https://huggingface.co/settings/tokens)
HF_TOKEN=your_huggingface_token_here
# Compute device: cuda or cpu (auto-fallback on OOM)
DEVICE=cuda
# WandB project for logging
WANDB_PROJECT=your_project_name
# API host/port
API_HOST=0.0.0.0
API_PORT=8000

# Azure Application Insights OpenTelemetry Connection String
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=your-instrumentation-key-here;IngestionEndpoint=https://your-region.in.applicationinsights.azure.com/

# Hardware Abstraction Layer backend (simulated | zmq)
RECEIVER_BACKEND=simulated
ZMQ_RECEIVER_ADDR=tcp://localhost:5555
