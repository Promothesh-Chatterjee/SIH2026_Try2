# HuggingFace Token for downloading TSRD dataset (https://huggingface.co/settings/tokens)
HF_TOKEN=your_huggingface_token_here
# Compute device: cuda or cpu (auto-fallback on OOM)
DEVICE=cuda
# WandB project for logging
WANDB_PROJECT=your_project_name
# API host/port
API_HOST=0.0.0.0
API_PORT=8000

# Azure Application Insights OpenTelemetry Connection String
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=your-instrumentation-key-here;IngestionEndpoint=https://your-region.in.applicationinsights.azure.com/

# Hardware Abstraction Layer backend (simulated | zmq)
RECEIVER_BACKEND=simulated
ZMQ_RECEIVER_ADDR=tcp://localhost:5555

# TSRD Dataset & Authentication Configuration (Phase 3)
TSRD_DATA_ROOT=D:/TSRD
SMARTSCAN_API_KEYS=your-key-1,your-key-2
AZURE_BLOB_ACCOUNT=
AZURE_BLOB_CONTAINER=tsrd-dataset

# Live Azure AKS Deployment Configuration
# Live cluster load balancer public IP/URL
AKS_ENDPOINT=http://172.198.227.59

# Set for authenticated deployment access (X-SmartScan-API-Key / X-API-Key header)
SMARTSCAN_API_KEY=your_smartscan_api_key_here

# Frontend Vite configuration
VITE_API_BASE_URL=http://localhost:8000
VITE_SMARTSCAN_API_KEY=your_smartscan_api_key_here
