- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\nclass blk(gr.sync_block):\n\
      \    \"\"\"\n    Embedded Python Block for Frequency Hopping Spread Spectrum\
      \ (FHSS) Simulation\n    \"\"\"\n    def __init__(self, sample_rate=32000, hop_dwell_time=0.05,\
      \ freqs=[-120000, -90000, -60000, -30000, 0, 30000, 60000, 90000, 120000]):\n\
      \        gr.sync_block.__init__(\n            self,\n            name=\"FHSS\
      \ Signal Source\",\n            in_sig=None,\n            out_sig=[np.complex64]\n\
      \        )\n        self.sample_rate = sample_rate\n        self.hop_dwell_time\
      \ = hop_dwell_time\n        self.freqs = freqs\n        \n        self.samples_per_hop\
      \ = int(self.sample_rate * self.hop_dwell_time)\n        self.current_sample_count\
      \ = 0\n        self.current_freq_idx = 0\n        self.phase = 0.0\n\n    def\
      \ work(self, input_items, output_items):\n        out = output_items[0]\n  \
      \      noutput_items = len(out)\n        dt = 1.0 / self.sample_rate\n     \
      \   \n        for i in range(noutput_items):\n            if self.current_sample_count\
      \ >= self.samples_per_hop:\n                self.current_sample_count = 0\n\
      \                self.current_freq_idx = np.random.randint(0, len(self.freqs))\n\
      \            \n            freq = self.freqs[self.current_freq_idx]\n      \
      \      \n            out[i] = np.exp(1j * self.phase)\n            self.phase\
      \ += 2 * np.pi * freq * dt\n            self.phase = self.phase % (2 * np.pi)\n\
      \            \n            self.current_sample_count += 1\n            \n  \
      \      return noutput_items"
    affinity: ''
    alias: ''
    comment: ''
    freqs: '[-120000, -90000, -60000, -30000, 0, 30000, 60000, 90000, 120000]'
    hop_dwell_time: '0.05'
    maxoutbuf: '0'
    minoutbuf: '0'
    sample_rate: '32000'
  states:
    _io_cache: ('FHSS Signal Source', 'blk', [('sample_rate', '32000'), ('hop_dwell_time',
      '0.05'), ('freqs', '[-120000, -90000, -60000, -30000, 0, 30000, 60000, 90000,
      120000]')], [], [('0', 'complex', 1)], '\n    Embedded Python Block for Frequency
      Hopping Spread Spectrum (FHSS) Simulation\n    ', ['freqs', 'hop_dwell_time',
      'sample_rate'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [72, 256.0]
    rotation: 0
    state: enabled
